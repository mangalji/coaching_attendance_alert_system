DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL takes precedence when supplied. Choose one approach below.
# SQLite: DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# MySQL: DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=sqlite:///db.sqlite3
# Or omit DATABASE_URL and configure explicitly:
# DATABASE_ENGINE=sqlite  # sqlite | postgresql | mysql
# DATABASE_NAME=db.sqlite3
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=
DATABASE_CONN_MAX_AGE=60
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Kolkata
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=attendance_absent_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_IN
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
WHATSAPP_GRAPH_VERSION=v25.0
# Optional: 32-byte URL-safe Fernet key used to encrypt admin-entered WhatsApp tokens.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=
