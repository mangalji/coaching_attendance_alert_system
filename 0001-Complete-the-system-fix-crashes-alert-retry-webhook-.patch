index 2c6344e..895d775 100644
--- a/core/management/commands/process_alerts.py
+++ b/core/management/commands/process_alerts.py
@@ -1,9 +1,28 @@
+import time
+
 from django.core.management.base import BaseCommand
+
 from core.services import dispatch_pending_notifications
 
 
 class Command(BaseCommand):
-    help = "Queue and send due guardian WhatsApp alerts; run periodically using one scheduler."
+    help = (
+        "Queue and send due guardian WhatsApp alerts. Run once from a scheduler (cron), "
+        "or use --loop to keep a worker process running."
+    )
+
+    def add_arguments(self, parser):
+        parser.add_argument("--loop", action="store_true", help="Keep running instead of exiting.")
+        parser.add_argument("--interval", type=int, default=60, help="Seconds between runs with --loop.")
 
-    def handle(self, *args, **kwargs):
-        self.stdout.write(str(dispatch_pending_notifications()))
+    def handle(self, *args, **options):
+        while True:
+            try:
+                self.stdout.write(str(dispatch_pending_notifications()))
+            except Exception as exc:  # keep the worker alive across transient DB/network errors
+                if not options["loop"]:
+                    raise
+                self.stderr.write(f"process_alerts error: {exc}")
+            if not options["loop"]:
+                break
+            time.sleep(max(options["interval"], 5))
diff --git a/core/management/commands/setup_institute.py b/core/management/commands/setup_institute.py
new file mode 100644
index 0000000..7f5b5b2
--- /dev/null
+++ b/core/management/commands/setup_institute.py
@@ -0,0 +1,42 @@
+import getpass
+
+from django.contrib.auth import get_user_model
+from django.core.management.base import BaseCommand, CommandError
+
+from core.models import Institute, Profile
+
+
+class Command(BaseCommand):
+    help = "First-run setup: create/update the institute and its first administrator."
+
+    def add_arguments(self, parser):
+        parser.add_argument("--name", help="Institute name")
+        parser.add_argument("--admin-email")
+        parser.add_argument("--admin-name", default="Administrator")
+        parser.add_argument("--admin-password", help="Omit to be prompted")
+
+    def handle(self, *args, **o):
+        User = get_user_model()
+        name = o["name"] or input("Institute name: ").strip()
+        email = (o["admin_email"] or input("Admin email: ").strip()).lower()
+        if not name or not email:
+            raise CommandError("Institute name and admin email are required.")
+        institute = Institute.objects.first() or Institute()
+        institute.name = name
+        institute.save()
+        user = User.objects.filter(email__iexact=email).first()
+        if not user:
+            password = o["admin_password"] or getpass.getpass("Admin password: ")
+            if len(password) < 8:
+                raise CommandError("Password must be at least 8 characters.")
+            user = User.objects.create_user(
+                username=email, email=email, password=password, first_name=o["admin_name"],
+                is_staff=True, is_superuser=True,
+            )
+            self.stdout.write(f"Created administrator {email}.")
+        else:
+            user.is_staff = user.is_superuser = True
+            user.save(update_fields=["is_staff", "is_superuser"])
+            self.stdout.write(f"Promoted existing user {email} to administrator.")
+        Profile.objects.update_or_create(user=user, defaults={"role": "admin"})
+        self.stdout.write(self.style.SUCCESS(f"Institute '{name}' ready. Sign in via Admin Login."))
